    "@types/node": "24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "4.0.1",
    "jest": "30.1.2",
    "prisma": "6.11.0",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
